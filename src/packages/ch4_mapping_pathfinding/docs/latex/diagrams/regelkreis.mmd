%% Sequenzdiagramm: Regelkreis ueber eine Kreuzung
%% Interne Arbeit steht als 'note over', nicht als Selbstnachricht:
%% deren Text ueberdeckt sonst die Schleife und die Schrittnummer.
%% 'Wahrnehmung' buendelt detect_lane, detect_signs und
%% detect_intersection: als ausgeschriebene Spur war sie so breit,
%% dass das ganze Bild verkleinert werden musste.
%%{init: {"themeVariables": {"fontSize": "22px"}, "sequence": {"actorFontSize": 20, "messageFontSize": 19, "noteFontSize": 19, "actorMargin": 45, "boxMargin": 12}}}%%
sequenceDiagram
  autonumber
  participant K as Kamera
  participant D as Wahrnehmung
  participant S as switch_control
  participant C as control_wheels
  participant M as mapping_pathplanning

  rect rgb(238,244,255)
    note over K,C: Innenschleife, 30 Hz, laeuft durchgehend
    K->>D: Bild
    D->>C: /detect/lane
    note over C: PID, Radkommando
  end

  D->>S: /detect/intersection<br>(Haltelinie erreicht)
  S->>C: /switch/mode = STOPPED
  note over C: anhalten

  note over M: Route neu planen
  M->>S: /plan/turn_command

  S->>C: /switch/mode = CROSSING<br>/switch/turn_direction
  note over C: fester Bogen fahren
  K->>D: Bild
  D->>S: Fahrbahnmarkierungen wieder sichtbar
  S->>C: /switch/mode = LANE_FOLLOWING
  S->>M: Querung abgeschlossen

  note over M: Position weiterruecken,<br>Zeiten ablegen, erneut planen

  note over M: Aeussere Schleife: einmal pro Kreuzung
