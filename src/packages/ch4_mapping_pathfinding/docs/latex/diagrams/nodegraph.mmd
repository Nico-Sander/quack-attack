%% ROS Node Graph -> img/nodegraph.png
%% Bewusst vereinfacht: gezeigt wird der Hauptdatenfluss, nicht jedes Topic.
%% Weggelassen sind car_cmd an mapping_pathplanning (startet nur die
%% Zeitmessung) und die Debug-Topics im Einzelnen.
%% Enthalten ist dagegen lane_borders an switch_control: ueber diese Kante
%% endet die Querung, sobald wieder Markierungen sichtbar sind.
%% KEINE subgraph-Rahmen: mermaid setzt deren Titel mittig oben in den Rahmen,
%% wo bereits ein Node steht, und legt Kantenbeschriftungen von Kanten, die den
%% Rahmen kreuzen, INNEN ab. Beides war unleserlich. Die Schichten stecken
%% deshalb in der Farbe, die Legende steht in der Bildunterschrift.
%% Topicnamen ohne den Fahrzeug-Namespace, damit die Kanten schmal bleiben.
%%{init: {"themeVariables": {"fontSize": "26px"}, "flowchart": {"nodeSpacing": 50, "rankSpacing": 65, "padding": 10}}}%%
flowchart TB
  cam([Kamera]):::ext

  dl[detect_lane]:::perc
  di[detect_intersection]:::perc
  ds[detect_signs]:::perc

  sc[switch_control]:::beh
  cw[control_wheels]:::beh

  mp[mapping_pathplanning]:::mission

  viz[visualization]:::ui
  dash[dashboard]:::ui

  motor([Radansteuerung]):::ext

  cam -- Bild --> dl
  cam -- Bild --> ds
  dl -- lane_borders --> di

  di -- intersection --> sc
  dl -- lane_borders --> sc
  ds -- sign --> sc
  dl -- lane --> cw
  sc -- "mode<br>turn_direction" --> cw
  cw -- car_cmd --> motor

  ds -- sign_detections --> mp
  sc -- "mode, turn_direction" --> mp
  mp -- "turn_command, resume_driving" --> sc

  mp -- mapping/state --> viz
  dl -- Debugbilder --> dash

  classDef ext  fill:#eeeeee,stroke:#999999,stroke-dasharray:4 3
  classDef perc fill:#e8f0ff,stroke:#4a76c8
  classDef beh  fill:#e6f6ec,stroke:#3a9d5d
  classDef ui   fill:#f3f0fa,stroke:#8a7bb8
  classDef mission fill:#ffe9e9,stroke:#c00000,stroke-width:2px
  %% Kante 11 (ab 0 gezaehlt): turn_command schliesst den Regelkreis.
  linkStyle 11 stroke:#c00000,stroke-width:3px
