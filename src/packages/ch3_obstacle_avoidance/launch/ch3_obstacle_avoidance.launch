<launch>
    <!--
      Obstacle-avoidance stack (lean: reactive follow-the-gap, no memory/mapping).

      Normal driving stack:
          roslaunch ch3_obstacle_avoidance ch3_obstacle_avoidance.launch

      Tuning / dry run - full stack, dashboard fully populated, robot stationary:
          roslaunch ch3_obstacle_avoidance ch3_obstacle_avoidance.launch controller:=false

      controller:=false does NOT stop the controller node. The node runs and plans
      exactly as it normally would; it just never publishes a drive command. That
      distinction matters: the whole dashboard overlay - blocked and free spans, the
      chosen gap, the target column, the FSM state - is fed by /debug/free_path_plan,
      and control_lane_node is its only publisher. Killing the node would blank out
      the very visualization you tune against.

      STARTUP SAFETY
      roslaunch starts these at once with no ordering guarantee, and the detectors
      are far slower to come up than the controller (U-Net JIT trace, YOLO load).
      An absent /detect/duckie_BB is indistinguishable from "no duckies ahead", so
      the controller holds still until it has seen /detect/lane, /detect/lane_borders
      AND /detect/duckie_BB at least once. That gate lives in control_lane_node
      (sensors_ready), because only the node writing the command can enforce it.
    -->

    <arg name="lane" default="true"
         doc="Lane segmentation. Publishes /detect/lane and /detect/lane_borders." />
    <arg name="detector" default="true"
         doc="YOLO duckie detection. Publishes /detect/duckie_BB." />
    <arg name="controller" default="true"
         doc="Publish drive commands. false = dry run: node still plans and feeds the dashboard, robot stays still." />
    <arg name="dashboard" default="true"
         doc="Camera debug dashboard. Purely visual; needs X11." />

    <!--
      Start the controller node at all. Almost always true - use controller:=false
      for a dry run instead. This exists only for the rare case where another node
      needs sole ownership of car_cmd_switch_node/cmd.
    -->
    <arg name="controller_node" default="true"
         doc="Start control_lane_node at all. Use controller:=false for a dry run instead." />

    <!-- Lane Detection (segmentation, lane error, lane borders) -->
    <node pkg="ch3_obstacle_avoidance" type="detect_lane_node.py" name="detect_lane_node"
          output="screen" if="$(arg lane)" />

    <!-- Duckie Detection (YOLO) -> /detect/duckie_BB -->
    <node pkg="ch3_obstacle_avoidance" type="detect_obstacle_node.py" name="detect_obstacle_node"
          output="screen" if="$(arg detector)" />

    <!--
      Lane Following & Duckie Avoidance Control.

      THE ONLY node here that moves the robot. Exactly one node may publish
      car_cmd_switch_node/cmd; with controller:=false it registers no publisher on
      that topic at all, so the invariant holds trivially during a dry run.
    -->
    <node pkg="ch3_obstacle_avoidance" type="control_lane_node.py" name="control_lane_node"
          output="screen" if="$(arg controller_node)">
        <param name="publish_cmd" value="$(arg controller)" />
    </node>

    <!-- Dashboard/UI -->
    <node pkg="ch3_obstacle_avoidance" type="dashboard_node.py" name="dashboard_node"
          if="$(arg dashboard)" />
</launch>
