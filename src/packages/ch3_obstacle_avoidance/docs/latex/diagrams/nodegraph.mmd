%% ROS Node Graph -> img/nodegraph.png
%% Farbschema und Aufbau wie in der Doku zu Challenge 4 (mapping_pathfinding).
%% KEINE subgraph-Rahmen: mermaid setzt deren Titel mittig oben in den Rahmen,
%% wo bereits ein Node steht, und legt Kantenbeschriftungen von Kanten, die den
%% Rahmen kreuzen, INNEN ab. Die Schichten stecken deshalb in der Farbe.
%% Weggelassen: die Debugbilder beider Detektoren ans Dashboard und
%% lane_borders an detect_obstacle_node. Beide gehoeren nicht zur Hauptlogik.
%% Topicnamen ohne den Fahrzeug-Namespace, damit die Kanten schmal bleiben.
%%{init: {"themeVariables": {"fontSize": "26px"}, "flowchart": {"nodeSpacing": 50, "rankSpacing": 65, "padding": 10}}}%%
flowchart TB
  cam([Kamera]):::ext

  dl[detect_lane_node]:::perc
  do[detect_obstacle_node]:::perc

  cl[control_lane_node]:::mission

  dash[dashboard_node]:::ui

  motor([Radansteuerung]):::ext

  cam -- Bild --> dl
  cam -- Bild --> do
  dl -- lane --> cl
  dl -- lane_borders --> cl
  do -- duckie_BB --> cl
  do -- duckie_BB --> dl
  cl -- car_cmd --> motor
  cl -- free_path_plan --> dash

  classDef ext  fill:#eeeeee,stroke:#999999,stroke-dasharray:4 3
  classDef perc fill:#e8f0ff,stroke:#4a76c8
  classDef ui   fill:#f3f0fa,stroke:#8a7bb8
  classDef mission fill:#ffe9e9,stroke:#c00000,stroke-width:2px
