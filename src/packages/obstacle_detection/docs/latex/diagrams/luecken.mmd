%%{init: {"themeVariables": {"fontSize": "30px"}, "flowchart": {"nodeSpacing": 35, "rankSpacing": 50, "padding": 10}}}%%
flowchart LR
  L["Linienpositionen<br>(entprellt)"]:::perc --> K["Korridor [L, R]<br>harte Grenzen"]:::calc
  D["Enten-Boxen<br>aus YOLO"]:::perc --> V["nach Naehe verbreitern,<br>zusammenfassen"]:::calc
